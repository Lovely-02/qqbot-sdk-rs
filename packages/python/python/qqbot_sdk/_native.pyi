from collections.abc import Awaitable, Callable
from typing import Any, Literal

from .api import BotApi

class BotError(Exception): ...

class ApiError(BotError):
    status: int
    code: int
    message: str
    trace_id: str | None
    data: Any

class Bot:
    def __init__(
        self,
        app_id: str,
        app_secret: str,
        *,
        mode: Literal["public", "private", "webhook"] = "public",
        intents: int | None = None,
        api_base_url: str | None = None,
    ) -> None: ...
    @property
    def api(self) -> BotApi: ...
    def user(self, user_openid: str) -> User: ...
    def group(self, id: str) -> Target: ...
    def channel(self, id: str) -> Target: ...
    def direct(self, id: str) -> Target: ...
    def _call(self, operation: str, *args: Any) -> Awaitable[Any]: ...
    def _upload_material(
        self, file_name: str, content_type: str, data: bytes
    ) -> Awaitable[dict[str, Any]]: ...
    def _upload_media(
        self, kind: Literal["user", "group"], id: str, file_type: int,
        data: bytes, srv_send_msg: bool = False,
    ) -> Awaitable[dict[str, Any]]: ...
    def _send_media(
        self, kind: Literal["user", "group"], id: str, file_type: int,
        data: bytes, message: str | dict[str, Any],
    ) -> Awaitable[dict[str, Any]]: ...
    def handle_webhook(
        self, timestamp: str, signature: str, body: bytes
    ) -> dict[str, Any]: ...
    def run(self, callback: Callable[[dict[str, Any]], None]) -> Awaitable[None]: ...
    def stop(self) -> None: ...

class Target:
    @property
    def id(self) -> str: ...
    def send(
        self, content: str | dict[str, Any], *, msg_id: str | None = None
    ) -> Awaitable[dict[str, Any]]: ...
    def recall(self, message_id: str, hide_tip: bool = False) -> Awaitable[None]: ...

class User(Target): ...
